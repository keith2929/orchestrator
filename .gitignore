# Secrets — provider API keys live here, loaded into process.env at startup.
# Never commit this. Use .env.example as the template.
.env
.env.local

# Detached-launcher runtime (pids + logs from ./run.sh)
.run/

# Dependencies
node_modules/

# Runtime/state — regenerated at runtime, not source
logs/
error_logs/
performance.json
config.json.bak
*.bak
*.bak-*
.goutputstream-*

# Project state now lives in <targetDir>/.orchestrator/ (see REDESIGN_PLAN.md
